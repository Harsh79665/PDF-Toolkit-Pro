# PDF Utility Toolkit — Environment Variables Example Template
# Rename this file to .env for local configuration

# Web Server Configuration
HOST=127.0.0.1
PORT=5000
DEBUG=False
SECRET_KEY=change-this-to-a-random-secure-secret-key-in-production

# Security & Processing Constraints
MAX_UPLOAD_SIZE_BYTES=1073741824 # 1 GB in bytes
MAX_PAGES_LIMIT=500              # Maximum allowed pages per document
FILE_EXPIRATION_HOURS=24       # Automatic asset retention window (hours)
